NODE_ENV=development
PORT=5000

# Use a local replica set or MongoDB Atlas connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/ltms

# Generate separate random values with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS origin for the frontend.
CLIENT_URL=http://localhost:5173

# Redis URL
REDIS_URL=redis://127.0.0.1:6379

# Seat lock configuration (in seconds)
SEAT_LOCK_TTL_SECONDS=600
MAX_SEAT_LOCK_DURATION_SECONDS=900

# API request throttling.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

